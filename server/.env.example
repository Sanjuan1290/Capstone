# ============================================================
# CARAIT CLINIC SYSTEM — RENDER PRODUCTION ENVIRONMENT
# Cloudflare Pages + Render + TiDB Cloud
# ============================================================


# ── SERVER ───────────────────────────────────────────────────
NODE_ENV=production

# Render automatically provides PORT.
# PORT=3000


# ── DATABASE — TIDB CLOUD ────────────────────────────────────
DB_PROVIDER=tidb
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=carait_clinic_system

DB_SSL=true
DB_SSL_CA_PATH=

DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUEUE_LIMIT=0
DB_TIME_ZONE=+08:00

RUN_SCHEMA_MIGRATIONS_ON_STARTUP=false


# ── JWT AUTHENTICATION ───────────────────────────────────────
JWT_SECRET=

SESSION_TTL=7d


# ── CLOUDFLARE API PROXY SECURITY ────────────────────────────
API_PROXY_SECRET=

TRUST_PROXY=false


# ── CLIENT URL / CORS ────────────────────────────────────────
CLIENT_URL=https://caraitclinic.com


# ── EMAIL — RESEND HTTPS API ONLY ─────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=CARAIT Clinic <no-reply@caraitclinic.com>


# ── SMS — SEMAPHORE ──────────────────────────────────────────
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=

# Only set this if approved by Semaphore.
# SEMAPHORE_SENDER_NAME=CARAITMED


# ── SECURITY / SESSIONS ──────────────────────────────────────
ADMIN_MFA_ENABLED=true

JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb


# ── CLOUDINARY ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLINICAL_FOLDER=carait-clinic/clinical
CLOUDINARY_PAYMENT_FOLDER=carait-clinic/payment-qr


# ── CLINIC SETTINGS ──────────────────────────────────────────
CLINIC_TIMEZONE=Asia/Manila

SEED_DEMO_DATA=false


# ── QUEUE DISPLAY ────────────────────────────────────────────
QUEUE_DISPLAY_PIN=
QUEUE_DISPLAY_SESSION_HOURS=12


# ── APPOINTMENT SETTINGS ─────────────────────────────────────
APPOINTMENT_NO_SHOW_GRACE_MINUTES=15


# ── PAYMONGO — TEST / LIVE (LIVE OFF BY DEFAULT) ───────────
# LIVE requires matching credentials, verified PayMongo activation, and
# PAYMONGO_LIVE_ENABLED=true after isolated real-money acceptance tests.


# PayMongo live collection stays OFF until independently verified and activated.
# Set PAYMONGO_MODE=live + matching sk_live_/pk_live_ + live webhook secret,
# then, only after successful staging tests/merchant activation, set the explicit gate true.
PAYMONGO_LIVE_ENABLED=false
# QR cancellation is intentionally disabled until verified against PayMongo TEST.
# Live QR cancellation also requires a separate explicit live gate.
PAYMONGO_QR_CANCEL_ENABLED=false
PAYMONGO_QR_CANCEL_LIVE_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=


# ── NEWS / OFFERS / EMAIL MARKETING ──────────────────────────
MARKETING_FROM_EMAIL=offers@caraitclinic.com
MARKETING_FROM_NAME=CARAIT Clinic
MARKETING_UNSUBSCRIBE_SECRET=
MARKETING_DAILY_LIMIT=200
MARKETING_PER_MINUTE_LIMIT=5


# ============================================================
# END — CARAIT CLINIC RENDER CONFIGURATION
# ============================================================



