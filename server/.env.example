# server/.env — copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────
PORT=
NODE_ENV=

# ── Database ──────────────────────────────────────────────────
# mysql for local database, tidb for TiDB Cloud
DB_PROVIDER=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
# TiDB: DB_PROVIDER=tidb, DB_PORT=4000, DB_SSL=true
# TLS certificate chain and hostname are verified; keep true for TiDB.
DB_SSL=false
# Optional, e.g. TiDB dedicated cluster CA certificate, mounted on Render.
DB_SSL_CA_PATH=
DB_POOL_SIZE=10

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=

# ── Email (Gmail SMTP) ────────────────────────────────────────
# How to get EMAIL_PASS (Gmail App Password):
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (must be ON)
#   3. Search "App passwords" → Generate one for "Mail"
#   4. Paste the 16-character code below (no spaces)
EMAIL_USER=
EMAIL_PASS=

# ── Semaphore SMS API ─────────────────────────────────────────
# Get this from your Semaphore dashboard
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
# Sender Name is optional; set it only after Semaphore approves it.
# SEMAPHORE_SENDER_NAME=CARAITMED

# ── Client URL (for email links + CORS) ──────────────────────
CLIENT_URL=


# Optional demo seed data. Keep false in production.
SEED_DEMO_DATA=false


# ── Security / Sessions ───────────────────────────────────────
# Admin login requires an email OTP by default. Set false only for local development.
ADMIN_MFA_ENABLED=true
SESSION_TTL=7d
# Set true only when the app is behind a trusted reverse proxy/load balancer that supplies the real client IP.
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb

# ── Cloudinary — Signed Clinical Image Uploads ────────────────
# These are SERVER-ONLY credentials. Never prefix the API secret with VITE_.
# Profile/landing-page images may continue using the client's existing unsigned preset;
# consultation/progress images use a server-generated signature from these credentials.
# Enable the Perception Point Malware Detection add-on in Cloudinary Marketplace.
# QR and clinical uploads request moderation=perception_point and remain unattached until approved.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLINICAL_FOLDER=carait-clinic/clinical
CLOUDINARY_PAYMENT_FOLDER=carait-clinic/payment-qr

# Clinic timezone used for appointment day boundaries and reminder scheduling.
CLINIC_TIMEZONE=Asia/Manila

# Production recommendation: keep false. Run `npm run migrate` during deployment.
# Local `npm run dev` already runs the idempotent migrator through the predev script.
RUN_SCHEMA_MIGRATIONS_ON_STARTUP=false

# ── Waiting-room Queue Display ────────────────────────────────
# Local development may use 123456 when this is omitted.
# Production MUST set a different 6-12 digit PIN.
QUEUE_DISPLAY_PIN=
# Display session lifetime in hours (maximum 24).
QUEUE_DISPLAY_SESSION_HOURS=12

# Minutes after the scheduled time before an unattended confirmed/rescheduled
# online appointment can be automatically marked No Show. Checked-in patients
# and walk-ins are always excluded.
APPOINTMENT_NO_SHOW_GRACE_MINUTES=15

# MySQL session time zone for every pooled connection (clinic local time, Asia/Manila has no DST).
DB_TIME_ZONE=+08:00




# ── PayMongo Dynamic QR Ph (TEST MODE ONLY) ──────────────────────────────
# TEST ONLY. Production deployment may use test credentials; do not set live keys.
# Set exactly "test" to enable test QR generation; leave empty to disable.
# PayMongo Dashboard → Developers → API Keys (test keys only).
# Do not scan test QR images with real money! Use the provider's test_url.
# Both test keys stay on the Express backend, NOT VITE_ / React.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Developers → Webhooks → test endpoint secret (different from API key).
# Configure a public HTTPS POST endpoint: https://YOUR_API_HOST/api/webhooks/paymongo
# Subscribe to payment.paid, payment.failed, qrph.expired. No localhost webhooks.
PAYMONGO_WEBHOOK_SECRET=

# ── DESTRUCTIVE QA INTEGRATION TEST SAFETY ────────────────────────────────
# Only set these in the terminal running `npm run test:mysql`, NEVER for the app.
# The *_test/*_qa database MUST be a separate disposable restored copy.
# Example in PowerShell: $env:CARAIT_TEST_DB_NAME='carait_qa_20261017'
# Explicit consent is mandatory; tests refuse to run without it.
# CARAIT_TEST_DB_NAME=
# CARAIT_ALLOW_TEST_DB_WRITES=YES

# Read-only local API preflight: npm run verify:runtime
# CARAIT_SMOKE_API_BASE=http://127.0.0.1:3000

# ── Public News & Offers / opt-in marketing email ─────────────
# Bulk email stays disabled until every required setting is configured.
BREVO_API_KEY=
MARKETING_FROM_EMAIL=
MARKETING_FROM_NAME=CARAIT Clinic
# Independent random 32+ character secret (not JWT_SECRET).
MARKETING_UNSUBSCRIBE_SECRET=
MARKETING_DAILY_LIMIT=200
MARKETING_PER_MINUTE_LIMIT=5
# CLIENT_URL must be publicly accessible over HTTPS in production.
# Cover images use existing signed Cloudinary API + Perception Point scanning.

