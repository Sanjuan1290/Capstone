{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "vitest run",
    "start": "node server.js",
    "predev": "npm run migrate",
    "dev": "nodemon server.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "node scripts/migrate.js",
    "prepare:tidb-dump": "node scripts/prepareTidbDump.js",
    "verify:deploy": "node scripts/verifyDeployment.js",
    "diagnose:consultation": "node scripts/diagnoseConsultationSchema.js",
    "verify:source": "node scripts/verifySourceGraph.js",
    "test:checkout": "node --test tests/checkouts/reopen-editing.node.cjs",
    "pretest": "npm run verify:source",
    "test:node": "node scripts/runNodeRegressionTests.js",
    "verify:reports-sql": "node scripts/verifyBranchReportsSql.js",
    "verify:runtime": "node scripts/verifyRuntimeReadOnly.js",
    "export:deployment": "node scripts/exportDeployment.js",
    "test:batchfree": "node --test tests/inventory/locationLedger.node.test.cjs tests/inventory/inventoryModeSafety.node.test.cjs",
    "test:all": "npm test && npm run test:node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.20.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  }
}
