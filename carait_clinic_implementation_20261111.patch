-    if (skip) return
-
-    // Immediate first call
-    savedFn.current()
-
-    // Schedule repeating calls
-    timerId.current = setInterval(run, intervalMs)
-
-    // Pause / resume on tab visibility change
-    const onVisibilityChange = () => {
-      if (document.visibilityState === 'visible') {
